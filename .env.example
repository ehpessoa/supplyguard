# ---------------------------------------------------------------------------
# SupplyGuard-AI — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Server ------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (dashboard, etc.)
CORS_ORIGIN=http://localhost:5173

# --- Google Gemini (LLM engine, via @google/genai) ----------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (Postgres + RLS multi-tenant persistence) ------------------
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-side only, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Redis / BullMQ (job queue broker) -----------------------------------
REDIS_URL=redis://localhost:6379

# --- Scheduling ------------------------------------------------------------
# Cron expression for the daily automated cost audit (default 06:00 AM server time)
AUDIT_CRON_SCHEDULE=0 6 * * *
# Comma-separated tenant_ids to run the scheduled audit job for
AUDIT_TENANT_IDS=00000000-0000-0000-0000-000000000001
